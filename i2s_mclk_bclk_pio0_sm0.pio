; i2s_mclk_bclk_pio0_sm0.pio
; Raspberry PICO 2, RP2350
; Auteur : jeanmarc.villers@wanadoo.fr
; Machine PIO de generation des horloges I2S MCLK (GPIO8) et BCLK (GPIO10) a
; partir de l'oscillateur a 24.576 MHz (GPIO15)
; Licence Creative Commons CC BY-NC-SA

; Division par 2 de 24.576, soit b0 de X pour MCLK, a 12.288 MHz
; Division par 8 de 24.576, soit b2 de X pour MCLK, a 3.072 MHz

.program i2s_mclk_bclk_pio0_sm0
    set X, 0
.wrap_target
encore:
    wait 0  GPIO    15 ; Attente d'un front descendant de l'oscillateur.
    mov PINS, X
    jmp X--, encore [2]; Delai pour attendre la remontee sur GPIO15
.wrap

% c-sdk {
static inline void pio0_sm0_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = i2s_mclk_bclk_pio0_sm0_program_get_default_config(offset);

    // Affectation de 3 GPIOs consecutives a partir de GPIO8
    // pour l'instruction OUT
    sm_config_set_out_pins(&c, 8, 3);
    pio_sm_set_consecutive_pindirs(pio, sm, 8, 3, true);

    // Set this pin's GPIO function (connect PIO to the pad)    
    pio_gpio_init(pio, 8); // Pour MCLK
    pio_gpio_init(pio, 10);// Pour BCLK - GPIO9 non utilisee.
    
    // Load our configuration, and jump to the start of the program
    pio_sm_init(pio, sm, offset, &c);
}
%}

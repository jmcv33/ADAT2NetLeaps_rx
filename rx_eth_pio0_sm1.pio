; rx_eth_pio0_sm1.pio
; Raspberry PICO 2, RP2350
; Auteur : jeanmarc.villers@wanadoo.fr
; Machine PIO de generation de LRCLK (GPIO11) à 48 KHz a partir de BCLK (GPIO10)
; Licence Creative Commons CC BY-NC-SA

.program rx_eth_pio0_sm1

.wrap_target ; 
    wait 1  GPIO    10 ; Attente du passage a 0 de BCLK.
    wait 0  GPIO    10
    set PINS, 1 ; Mise a 1 de LRCLK
    nop [12]  ; Ajustement de la duree de l'etat haut.
    set X, 31
loop: ; (X+1)x40#
    nop [31]
    nop [14]   
    JMP X-- loop

    wait 1  GPIO    10 ; Attente du passage a 0 de BCLK.
    wait 0  GPIO    10
    set PINS, 0
    set X, 31
loop2: ; (X+1)x40#
    nop [31]
    nop [14]   
    JMP X-- loop2
    nop [12]
.wrap

% c-sdk {
static inline void rx_eth_pio0_sm1_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = rx_eth_pio0_sm1_program_get_default_config(offset);

    // Affectation de GPIO11 a l'instruction SET
    sm_config_set_set_pins(&c, 11, 1);
    // Set the pin direction to output at the PIO
    pio_sm_set_consecutive_pindirs(pio, sm, 11, 1, true);

    // Set this pin's GPIO function (connect PIO to the pad)    
    pio_gpio_init(pio, 11);
    
    pio_sm_init(pio, sm, offset, &c);
}
%}
